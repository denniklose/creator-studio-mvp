# Browser-safe Supabase values. These are required for the login screen.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never commit a real value and never expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://creator-studio-mvp-coral.vercel.app/api/youtube/callback
YOUTUBE_TOKEN_ENCRYPTION_KEY=
APP_BASE_URL=https://creator-studio-mvp-coral.vercel.app

# Keep false locally and in every Preview deployment. Production only: true.
EXTERNAL_SERVICES_ENABLED=false
